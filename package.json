{
  "name": "crate-bell",
  "description": "Sale alerts for Discogs, made simple: one pink button on every record page.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "gregoiremalthes",
  "homepage": "https://gregoiremalthes.github.io/crate-bell/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gregoiremalthes/crate-bell.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm locales && wxt",
    "dev:firefox": "pnpm locales && wxt -b firefox",
    "build": "pnpm locales && wxt build",
    "build:firefox": "pnpm locales && wxt build -b firefox",
    "zip": "pnpm locales && wxt zip",
    "zip:firefox": "pnpm locales && wxt zip -b firefox",
    "postinstall": "node scripts/build-locales.mjs && wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "icons": "node scripts/build-icons.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "locales": "node scripts/build-locales.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.55.0",
    "@resvg/resvg-js": "^2.6.2",
    "happy-dom": "^20.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "wxt": "^0.21.5"
  }
}
